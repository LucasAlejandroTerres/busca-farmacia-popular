# ========================================================
# [Backend - Supabase]
# Configurações do Banco de Dados - Dashboard do Supabase -> Settings -> API
# ========================================================
SUPABASE_URL=https://SUA_URL_AQUI.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA_AQUI
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_SECRETA_AQUI

# ========================================================
# [Backend/ETL - Processamento Geospacial]
# Opcional para executar scripts da camada /ETL (em Python)
# ========================================================
GOOGLE_GEOCODING_API_KEY=AIzaSy_SUA_CHAVE_GOOGLE_AQUI

# ========================================================
# [Frontend - Aplicação React/Vite]
# Variáveis expostas no lado do cliente. NUNCA DEIXE KEYS SECRETAS AQUI
# Copie do cabeçalho de Backend acima:
# ========================================================
VITE_SUPABASE_URL=https://SUA_URL_AQUI.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA_AQUI
